/* pages/typhoon/typhoon.wxss */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 180rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: #ffffff;
}

.header {
  padding: 16rpx 0 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.header-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.year-switch {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
}

.year-btn {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.7);
}

.year-active {
  background: rgba(79, 172, 254, 0.35);
  color: #ffffff;
  font-weight: 600;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.retry-btn {
  margin-top: 24rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: rgba(79, 172, 254, 0.35);
  border-radius: 999rpx;
}

/* 台风列表 */
.storm-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.storm-list {
  display: inline-flex;
  padding: 6rpx 4rpx;
}

.storm-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  padding: 20rpx 24rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.storm-active {
  background: rgba(79, 172, 254, 0.25);
  border-color: rgba(79, 172, 254, 0.6);
}

.storm-name {
  font-size: 32rpx;
  font-weight: 600;
}

.storm-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.status-active {
  color: #ffd24a;
}

/* 当前台风信息 */
.info-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx 16rpx;
}

.info-cell {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.info-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 台风路径地图 */
.map-section {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.typhoon-map {
  width: 100%;
  height: 560rpx;
  filter: brightness(0.65) contrast(1.15) saturate(1.4);
}

/* 图例 */
.map-legend {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(13, 27, 61, 0.7);
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.legend-item:last-child {
  margin-right: 0;
}

.legend-line {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 10rpx;
}

.legend-track {
  background: #ffd24a;
}

.legend-forecast {
  background: #4facfe;
}

.legend-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 节点详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
}

.detail-popup {
  position: fixed;
  transform: translate(-50%, -100%);
  margin-top: -20rpx;
  z-index: 101;
}

.detail-arrow {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #1a1a2e;
}

.detail-card {
  width: 520rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

.detail-header {
  display: flex;
  align-items: center;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.detail-type {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.type-track {
  background: rgba(255, 210, 74, 0.3);
  color: #ffd24a;
}

.type-forecast {
  background: rgba(79, 172, 254, 0.3);
  color: #7ab8ff;
}

.detail-time {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.detail-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
}

.d-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.d-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 时间轴 */
.timeline-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.timeline-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
}

.timeline-point {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.timeline-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-track {
  background: rgba(255, 210, 74, 0.3);
  color: #ffd24a;
}

.tag-forecast {
  background: rgba(79, 172, 254, 0.3);
  color: #7ab8ff;
}

.timeline-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.timeline-time {
  font-size: 28rpx;
  font-weight: 600;
}

.timeline-detail {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}
