/* pages/city/city.wxss */
.city-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: #ffffff;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 30rpx;
  background: transparent;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #ffffff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-right {
  width: 60rpx;
}

/* 搜索框 */
.search-section {
  padding: 20rpx 40rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 20rpx 25rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

/* 搜索结果 */
.search-results {
  background: rgba(255, 255, 255, 0.1);
  margin: 0 40rpx;
  border-radius: 15rpx;
  overflow: hidden;
}

.search-result-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.search-result-item:last-child {
  border-bottom: none;
}

.result-name {
  flex: 1;
  font-size: 28rpx;
}

.result-info {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-right: 20rpx;
}

.result-add {
  font-size: 36rpx;
  color: #4facfe;
}

/* 当前位置 */
.location-section {
  padding: 20rpx 40rpx;
}

.location-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  padding: 25rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.location-text {
  font-size: 28rpx;
}

/* 城市列表 */
.city-list-section {
  padding: 20rpx 40rpx;
}

.section-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 15rpx;
}

.city-list {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  overflow: hidden;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.city-item:last-child {
  border-bottom: none;
}

.city-info {
  display: flex;
  align-items: center;
}

.city-name {
  font-size: 28rpx;
}

.city-current {
  font-size: 22rpx;
  color: #4facfe;
  margin-left: 15rpx;
  background: rgba(79, 172, 254, 0.2);
  padding: 5rpx 15rpx;
  border-radius: 10rpx;
}

.city-actions {
  display: flex;
  align-items: center;
}

.city-delete {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 10rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}