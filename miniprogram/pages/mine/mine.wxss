/* pages/mine/mine.wxss */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx 180rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: #ffffff;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  display: block;
  line-height: normal;
  border-radius: 50%;
  background: transparent;
  border: none;
  overflow: hidden;
  font-size: 0;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: rgba(255, 255, 255, 0.15);
}

.profile-info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  height: 52rpx;
  line-height: 52rpx;
}

.member {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.menu-card {
  margin-top: 32rpx;
  padding: 8rpx 36rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  font-size: 34rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
}

.menu-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.menu-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.4);
}