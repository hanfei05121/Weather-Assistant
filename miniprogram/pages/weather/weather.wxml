<!--pages/weather/weather.wxml-->
<view class="weather-container" style="background: {{backgroundStyle}}">
  <canvas type="webgl" id="weather-canvas" class="weather-canvas"></canvas>

  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在获取天气数据...</text>
  </view>

  <view class="error-container" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="loadWeatherData">重试</button>
  </view>

  <scroll-view class="weather-scroll" scroll-y wx:else>
    <!-- 顶部城市和温度 -->
    <view class="weather-header">
      <view class="city-info" bindtap="onCityManage">
        <text class="city-name">{{currentCity}}</text>
        <text class="city-arrow">▾</text>
      </view>
      <text class="current-date">{{currentDate}}</text>

      <view class="temperature-main">
        <text class="temperature-value">{{weatherData.temperature}}</text>
        <text class="temperature-unit">°</text>
      </view>
      <text class="weather-condition">{{weatherData.condition}}</text>
      <text class="temperature-range">最高{{weatherData.high}}° 最低{{weatherData.low}}°</text>
    </view>

    <!-- 每小时预报卡片 -->
    <view class="glass-card hourly-section">
      <view class="section-title">每小时天气预报</view>
      <scroll-view class="hourly-scroll" scroll-x>
        <view class="hourly-list">
          <view class="hourly-item" wx:for="{{hourlyData}}" wx:key="hour">
            <text class="hourly-time">{{item.hour}}</text>
            <image class="hourly-icon" src="/images/weather/{{item.conditionCode}}.svg" mode="aspectFit"></image>
            <text class="hourly-temp">{{item.temperature}}°</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 10天预报卡片 -->
    <view class="glass-card daily-section">
      <view class="section-title">10日天气预报</view>
      <view class="daily-list">
        <view class="daily-item" wx:for="{{dailyData}}" wx:key="date" bindtap="onDailyTap" data-index="{{index}}">
          <text class="daily-weekday">{{item.weekDay}}</text>
          <image class="daily-icon" src="/images/weather/{{item.conditionCode}}.svg" mode="aspectFit"></image>
          <text class="daily-rain" wx:if="{{item.precipitation > 0}}">{{item.precipitation}}%</text>
          <text class="daily-rain daily-rain-none" wx:else></text>
          <text class="daily-temp-low">{{item.low}}°</text>
          <view class="daily-bar-container">
            <view class="daily-bar" style="left: {{item.barLeft}}%; width: {{item.barWidth}}%; background: linear-gradient(90deg, {{item.barColorFrom}}, {{item.barColorTo}});"></view>
          </view>
          <text class="daily-temp-high">{{item.high}}°</text>
        </view>
      </view>
    </view>

    <!-- 天气详情卡片 -->
    <view class="detail-grid">
      <!-- 体感温度 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="feelslike">
        <view class="card-title-row">
          <text class="card-title">体感温度</text>
        </view>
        <view class="card-main-value">
          <text class="card-big-number">{{weatherData.feelsLike}}</text>
          <text class="card-big-unit">°</text>
        </view>
      </view>

      <!-- 湿度 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="humidity">
        <view class="card-title-row">
          <text class="card-title">湿度</text>
        </view>
        <view class="card-main-value">
          <text class="card-big-number">{{weatherData.humidity}}</text>
          <text class="card-big-unit">%</text>
        </view>
      </view>

      <!-- 风 -->
      <view class="detail-card card-wind" bindtap="onWeatherDetailTap" data-type="wind">
        <view class="card-title-row">
          <text class="card-title">风</text>
        </view>
        <view class="wind-content">
          <view class="wind-info-rows">
            <view class="wind-row">
              <text class="wind-row-label">风力</text>
              <text class="wind-row-value">{{windForce}} 级</text>
            </view>
            <view class="wind-row">
              <text class="wind-row-label">阵风</text>
              <text class="wind-row-value">{{weatherData.windSpeed}} 米/秒</text>
            </view>
            <view class="wind-row wind-row-last">
              <text class="wind-row-label">方向</text>
              <text class="wind-row-value">{{weatherData.windDir}} {{windDirDeg}}°</text>
            </view>
          </view>
          <view class="compass-wrap">
            <view class="compass-circle">
              <view class="compass-tick" wx:for="{{compassTicks}}" wx:key="i" style="transform: rotate({{item}}deg)"></view>
            </view>
            <view class="compass-needle" style="transform: rotate({{windDirDeg}}deg)">
              <view class="needle-ball"></view>
              <view class="needle-shaft"></view>
              <view class="needle-arrow"></view>
            </view>
            <text class="compass-label compass-n">北</text>
            <text class="compass-label compass-s">南</text>
            <text class="compass-label compass-e">东</text>
            <text class="compass-label compass-w">西</text>
            <view class="compass-center">
              <text class="compass-center-num">{{windForce}}</text>
              <text class="compass-center-label">级</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 紫外线 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="uv">
        <view class="card-title-row">
          <text class="card-title">紫外线</text>
        </view>
        <view class="card-main-value">
          <text class="card-big-number">{{weatherData.uvIndex}}</text>
        </view>
        <view class="uv-bar-container">
          <view class="uv-bar-gradient"></view>
          <view class="uv-indicator" style="left: {{uvPercent}}%"></view>
        </view>
        <view class="uv-labels">
          <text class="uv-label">低</text>
          <text class="uv-label">中</text>
          <text class="uv-label">高</text>
          <text class="uv-label">极高</text>
        </view>
      </view>

      <!-- 日出日落 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="sun">
        <view class="card-title-row">
          <text class="card-title">日出日落</text>
        </view>
        <view class="sun-arc-container">
          <view class="sun-arc-line"></view>
          <view class="sun-arc-fill" style="width: {{sunArcPercent}}%"></view>
          <view class="sun-dot" style="left: {{sunArcPercent}}%"></view>
        </view>
        <view class="sun-times">
          <view class="sun-time-item">
            <text class="sun-time-value">{{weatherData.sunrise}}</text>
            <text class="sun-time-label">日出</text>
          </view>
          <view class="sun-time-item">
            <text class="sun-time-value">{{weatherData.sunset}}</text>
            <text class="sun-time-label">日落</text>
          </view>
        </view>
      </view>

      <!-- 能见度 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="visibility">
        <view class="card-title-row">
          <text class="card-title">能见度</text>
        </view>
        <view class="card-main-value">
          <text class="card-big-number">{{weatherData.visibility}}</text>
          <text class="card-big-unit">km</text>
        </view>
      </view>

      <!-- 气压 -->
      <view class="detail-card" bindtap="onWeatherDetailTap" data-type="pressure">
        <view class="card-title-row">
          <text class="card-title">气压</text>
        </view>
        <view class="card-main-value">
          <text class="card-big-number">{{weatherData.pressure}}</text>
          <text class="card-big-unit">hPa</text>
        </view>
      </view>

    </view>

    <!-- 空气质量 -->
    <view class="glass-card air-section" wx:if="{{airData}}">
      <view class="section-title">空气质量</view>
      <view class="air-main">
        <text class="air-aqi">{{airData.aqi}}</text>
        <view class="air-info">
          <text class="air-category">{{airData.category}}</text>
          <text class="air-desc">空气指数 AQI</text>
        </view>
      </view>
      <view class="air-grid">
        <view class="air-item">
          <text class="air-item-label">PM2.5</text>
          <text class="air-item-value">{{airData.pm25}}</text>
        </view>
        <view class="air-item">
          <text class="air-item-label">PM10</text>
          <text class="air-item-value">{{airData.pm10}}</text>
        </view>
      </view>
    </view>

    <!-- 生活指数 -->
    <view class="glass-card index-section" wx:if="{{indices.length}}">
      <view class="section-title">生活指数</view>
      <view class="index-grid">
        <view class="index-item" wx:for="{{indices}}" wx:key="type">
          <text class="index-name">{{item.name}}</text>
          <text class="index-category">{{item.category}}</text>
          <text class="index-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 预警信息 -->
    <view class="warning-section" wx:if="{{warnings.length}}">
      <view class="warning-item" wx:for="{{warnings}}" wx:key="id">
        <view class="warning-badge" style="background: {{item.severityColor}}"></view>
        <view class="warning-content">
          <text class="warning-title">{{item.title}}</text>
          <text class="warning-text">{{item.text}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
