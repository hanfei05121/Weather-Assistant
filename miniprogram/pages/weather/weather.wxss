/* pages/weather/weather.wxss */
.weather-container {
  min-height: 100vh;
  color: #ffffff;
}

/* 粒子特效画布（背景层） */
.weather-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.weather-scroll,
.loading-container,
.error-container {
  position: relative;
  z-index: 1;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
}

.retry-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.weather-scroll {
  height: 100vh;
}

/* 顶部区域 */
.weather-header {
  padding: 120rpx 40rpx 60rpx;
  text-align: center;
}

.city-info {
  display: inline-flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 500;
}

.city-arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.current-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 40rpx;
}

.temperature-main {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.temperature-value {
  font-size: 160rpx;
  font-weight: 200;
  line-height: 1;
}

.temperature-unit {
  font-size: 60rpx;
  font-weight: 200;
  margin-top: 20rpx;
}

.weather-condition {
  display: block;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.temperature-range {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 每小时预报 */
.hourly-section {
  padding: 30rpx 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  backdrop-filter: blur(10px);
}

.section-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
}

.hourly-scroll {
  white-space: nowrap;
}

.hourly-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.hourly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 20rpx;
}

.hourly-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 10rpx;
}

.hourly-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
}

.hourly-temp {
  font-size: 28rpx;
  font-weight: 500;
}

/* 7天预报 */
.daily-section {
  padding: 30rpx 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  margin: 0 30rpx 30rpx;
  backdrop-filter: blur(10px);
}

.daily-list {
  display: flex;
  flex-direction: column;
}

.daily-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.daily-item:last-child {
  border-bottom: none;
}

.daily-weekday {
  width: 100rpx;
  font-size: 28rpx;
}

.daily-icon {
  width: 50rpx;
  height: 50rpx;
  margin: 0 20rpx;
}

.daily-condition {
  width: 100rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.daily-temp-range {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.daily-temp-low {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  width: 60rpx;
  text-align: right;
}

.temp-bar {
  width: 100rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3rpx;
  margin: 0 15rpx;
  overflow: hidden;
}

.temp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4facfe, #f093fb);
  border-radius: 3rpx;
}

.daily-temp-high {
  font-size: 28rpx;
  width: 60rpx;
}

/* 天气详情模块 */
.detail-section {
  padding: 0 30rpx 30rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.detail-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 25rpx;
  backdrop-filter: blur(10px);
}

.detail-header {
  margin-bottom: 15rpx;
}

.detail-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.detail-content {
  display: flex;
  align-items: baseline;
}

.detail-value {
  font-size: 44rpx;
  font-weight: 300;
  margin-right: 8rpx;
}

.detail-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 空气质量 */
.air-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 25rpx;
  backdrop-filter: blur(10px);
}

.air-main {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.air-aqi {
  font-size: 72rpx;
  font-weight: 300;
  margin-right: 24rpx;
}

.air-info {
  display: flex;
  flex-direction: column;
}

.air-category {
  font-size: 30rpx;
}

.air-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 6rpx;
}

.air-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.air-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
}

.air-item-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.air-item-value {
  font-size: 30rpx;
  font-weight: 500;
}

/* 生活指数 */
.index-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.index-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  backdrop-filter: blur(10px);
}

.index-name {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.index-category {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin: 10rpx 0;
}

.index-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
}

/* 预警信息 */
.warning-list {
  display: flex;
  flex-direction: column;
}

.warning-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.warning-item:last-child {
  margin-bottom: 0;
}

.warning-badge {
  width: 14rpx;
  height: 100%;
  min-height: 56rpx;
  border-radius: 7rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.warning-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.warning-title {
  font-size: 28rpx;
  font-weight: 600;
}

.warning-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  margin-top: 8rpx;
}