/* pages/weather/weather.wxss */
.weather-container {
  min-height: 100vh;
  color: #ffffff;
}

.weather-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.weather-scroll,
.loading-container,
.error-container {
  position: relative;
  z-index: 1;
}

/* Loading & Error */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
}

.retry-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.weather-scroll {
  height: 100vh;
  padding-bottom: 40rpx;
}

/* ==================== 顶部区域 ==================== */
.weather-header {
  padding: 120rpx 40rpx 50rpx;
  text-align: center;
}

.city-info {
  display: inline-flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.city-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.current-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 30rpx;
}

.temperature-main {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.temperature-value {
  font-size: 180rpx;
  font-weight: 200;
  line-height: 1;
  letter-spacing: -6rpx;
}

.temperature-unit {
  font-size: 64rpx;
  font-weight: 200;
  margin-top: 16rpx;
}

.weather-condition {
  display: block;
  font-size: 34rpx;
  margin-bottom: 8rpx;
}

.temperature-range {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* ==================== 玻璃卡片公共样式 ==================== */
.glass-card {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin: 0 24rpx 24rpx;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.section-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-bottom: 20rpx;
}

/* ==================== 每小时预报 ==================== */
.hourly-scroll {
  white-space: nowrap;
}

.hourly-list {
  display: inline-flex;
  padding: 8rpx 0;
}

.hourly-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110rpx;
  margin-right: 16rpx;
}

.hourly-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.hourly-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.hourly-temp {
  font-size: 28rpx;
  font-weight: 500;
}

/* ==================== 10天预报 ==================== */
.daily-section {
  padding-bottom: 20rpx;
}

.daily-list {
  display: flex;
  flex-direction: column;
}

.daily-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.daily-item:last-child {
  border-bottom: none;
}

.daily-weekday {
  width: 80rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.daily-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.daily-rain {
  width: 64rpx;
  font-size: 24rpx;
  color: #5ac8fa;
  text-align: center;
  flex-shrink: 0;
}

.daily-rain-none {
  visibility: hidden;
}

.daily-temp-low {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.daily-bar-container {
  flex: 1;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 3rpx;
  margin: 0 16rpx;
  position: relative;
  overflow: hidden;
}

.daily-bar {
  position: absolute;
  top: 0;
  height: 100%;
  border-radius: 3rpx;
}

.daily-temp-high {
  font-size: 28rpx;
  width: 60rpx;
  flex-shrink: 0;
}

/* ==================== 详情卡片网格 ==================== */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx 24rpx;
}

.detail-card {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 24rpx;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.detail-card:active {
  opacity: 0.85;
}

.card-title-row {
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

.card-main-value {
  display: flex;
  align-items: baseline;
}

.card-big-number {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1.1;
}

.card-big-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 4rpx;
}

/* ==================== 风力卡片 ==================== */
.card-wind {
  grid-column: 1 / -1;
}

.wind-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 左侧信息行 */
.wind-info-rows {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wind-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}

.wind-row-last {
  border-bottom: none;
}

.wind-row-label {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.75);
}

.wind-row-value {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 右侧罗盘 */
.compass-wrap {
  width: 240rpx;
  height: 240rpx;
  position: relative;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 表盘圆环 */
.compass-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  z-index: 1;
}

/* 刻度线 — 以圆心为旋转原点 */
.compass-tick {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 2rpx;
  height: 14rpx;
  background: rgba(90, 200, 250, 0.5);
  transform-origin: 50% 112rpx;
  margin-left: -1rpx;
}

/* 指针 — 圆球 + 指杆 + 箭头，两端贯穿 */
.compass-needle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  transform-origin: 0 0;
  z-index: 2;
}

.needle-ball,
.needle-shaft,
.needle-arrow {
  position: absolute;
  z-index: 2;
}

.needle-ball {
  top: -92rpx;
  left: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.6);
}

.needle-shaft {
  top: -76rpx;
  left: -3rpx;
  width: 6rpx;
  height: 152rpx;
  background: #fff;
  border-radius: 3rpx;
}

.needle-arrow {
  top: 72rpx;
  left: 0;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 18rpx solid #fff;
  margin-left: -10rpx;
}

/* 中心圆 — 用 top/left 定位，不透明背景遮住指针，避免 transform 造成层级异常 */
.compass-center {
  position: absolute;
  top: 75rpx;
  left: 75rpx;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(50, 61, 86);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9;
}

.compass-center-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

.compass-center-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2rpx;
}

/* 方位文字 */
.compass-label {
  position: absolute;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  z-index: 5;
}

.compass-n { top: -8rpx; left: 50%; transform: translateX(-50%); }
.compass-s { bottom: -8rpx; left: 50%; transform: translateX(-50%); }
.compass-e { right: -8rpx; top: 50%; transform: translateY(-50%); }
.compass-w { left: -8rpx; top: 50%; transform: translateY(-50%); }

/* ==================== 紫外线卡片 ==================== */
.uv-bar-container {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  position: relative;
  margin: 16rpx 0 8rpx;
}

.uv-bar-gradient {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #4cd964, #ffcc00, #ff9500, #ff3b30);
}

.uv-indicator {
  position: absolute;
  top: -4rpx;
  width: 16rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 6rpx rgba(0, 0, 0, 0.3);
}

.uv-labels {
  display: flex;
  justify-content: space-between;
}

.uv-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ==================== 日出日落卡片 ==================== */
.sun-arc-container {
  width: 100%;
  height: 60rpx;
  position: relative;
  margin: 16rpx 0;
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  overflow: hidden;
}

.sun-arc-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 3rpx;
  background: #ffcc00;
  border-radius: 0 2rpx 2rpx 0;
}

.sun-dot {
  position: absolute;
  bottom: -6rpx;
  width: 14rpx;
  height: 14rpx;
  background: #ffcc00;
  border-radius: 50%;
  transform: translateX(-50%);
  box-shadow: 0 0 10rpx rgba(255, 204, 0, 0.6);
}

.sun-times {
  display: flex;
  justify-content: space-between;
}

.sun-time-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sun-time-value {
  font-size: 30rpx;
  font-weight: 500;
}

.sun-time-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

/* ==================== 空气质量 ==================== */
.air-section {
  margin-top: 4rpx;
}

.air-main {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.air-aqi {
  font-size: 72rpx;
  font-weight: 300;
  margin-right: 24rpx;
}

.air-info {
  display: flex;
  flex-direction: column;
}

.air-category {
  font-size: 30rpx;
  font-weight: 500;
}

.air-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 6rpx;
}

.air-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.air-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
}

.air-item-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.air-item-value {
  font-size: 30rpx;
  font-weight: 500;
}

/* ==================== 生活指数 ==================== */
.index-section {
  margin-top: 4rpx;
}

.index-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.index-item {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}

.index-name {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 6rpx;
}

.index-category {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.index-text {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ==================== 预警信息 ==================== */
.warning-section {
  padding: 0 24rpx 24rpx;
}

.warning-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.warning-item:last-child {
  margin-bottom: 0;
}

.warning-badge {
  width: 12rpx;
  min-height: 56rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.warning-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.warning-title {
  font-size: 28rpx;
  font-weight: 600;
}

.warning-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  margin-top: 8rpx;
}
