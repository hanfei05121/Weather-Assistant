/* pages/detail/detail.wxss */
.detail-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: #ffffff;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
}

.retry-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.detail-content {
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 30rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #ffffff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-right {
  width: 60rpx;
}

/* 天气概况 */
.condition-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.condition-icon {
  width: 120rpx;
  height: 120rpx;
}

.condition-text {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.temp-range {
  margin-top: 10rpx;
}

.temp-hi {
  font-size: 48rpx;
  font-weight: 600;
}

.temp-sep {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  margin: 0 8rpx;
}

.temp-lo {
  font-size: 48rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
}

/* 详情网格 */
.info-grid {
  padding: 20rpx 32rpx 100rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
}

.info-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.info-value {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.info-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.6);
}