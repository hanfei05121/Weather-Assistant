/* pages/detail/detail.wxss */
.detail-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: #ffffff;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.error-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 30rpx;
}

.retry-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.detail-content {
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 30rpx;
  background: transparent;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #ffffff;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
}

.nav-right {
  width: 60rpx;
}

/* 主要内容 */
.main-content {
  padding: 60rpx 40rpx;
  text-align: center;
}

.value-section {
  margin-bottom: 30rpx;
}

.main-value {
  font-size: 120rpx;
  font-weight: 200;
  line-height: 1;
}

.main-unit {
  font-size: 40rpx;
  font-weight: 200;
  margin-left: 10rpx;
}

.description-section {
  margin-top: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 图标 */
.icon-section {
  display: flex;
  justify-content: center;
  margin-top: 60rpx;
}

.detail-icon {
  width: 150rpx;
  height: 150rpx;
}