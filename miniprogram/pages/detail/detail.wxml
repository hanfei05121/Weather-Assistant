<!--pages/detail/detail.wxml-->
<view class="detail-container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载...</text>
  </view>

  <!-- 错误信息 -->
  <view class="error-container" wx:elif="{{error}}">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="loadDetailData">重试</button>
  </view>

  <!-- 详情内容 -->
  <view class="detail-content" wx:else>
    <!-- 顶部导航栏 -->
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">
        <text class="back-icon">←</text>
      </view>
      <text class="nav-title">{{dateTitle}}</text>
      <view class="nav-right"></view>
    </view>

    <!-- 天气图标和概况（仅日期详情） -->
    <view class="condition-header" wx:if="{{iconDay}}">
      <image class="condition-icon" src="/images/weather/{{iconDay}}.svg" mode="aspectFit"></image>
      <text class="condition-text">{{conditionText}}</text>
      <view class="temp-range" wx:if="{{tempMax}}">
        <text class="temp-hi">{{tempMax}}°</text>
        <text class="temp-sep">/</text>
        <text class="temp-lo">{{tempMin}}°</text>
      </view>
    </view>

    <!-- 详情数据网格 -->
    <view class="info-grid">
      <view class="info-item" wx:for="{{detailItems}}" wx:key="label">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}<text class="info-unit" wx:if="{{item.unit}}"> {{item.unit}}</text></text>
      </view>
    </view>
  </view>
</view>